{
  "manifest_version": 3,
  "name": "agentsweb.org — Cache for AI",
  "version": "1.0.0",
  "description": "Share web pages with AI agents. One click caches the page as clean markdown on agentsweb.org.",
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["extract.js"],
      "run_at": "document_idle"
    }
  ]
}
